# ── Environment ───────────────────────────────────────────────────────────────
# development (default) or production. In production, the app refuses to
# start unless JWT_SECRET_KEY is a real, non-placeholder secret (32+ chars).
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://smartwatchlist:smartwatchlist@localhost:5432/smart_market_watchlist

# ── Market Data ───────────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_finnhub_api_key_here
BENCHMARK_SYMBOL=SPY
# Optional secondary providers — see app/config.py for chain configuration.
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIMEOUT_SECONDS=8.0

# ── App Behaviour ─────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=45
LOG_LEVEL=INFO

# Demo user (fixed UUID — do not change)
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Comma-separated emails allowed to hit /api/admin/trigger-poll. Empty means
# nobody can — set this to your own account's email before deploying if you
# need the manual "Refresh" trigger in production.
ADMIN_EMAILS=

# ── CORS ─────────────────────────────────────────────────────────────────────
# The exact deployed frontend origin (no wildcard, no trailing slash).
# http://localhost:3000 is always allowed separately for local dev.
FRONTEND_ORIGIN=

# ── Demo Mode ────────────────────────────────────────────────────────────────
DEMO_MODE_ENABLED=true

# ── API Docs ─────────────────────────────────────────────────────────────────
DOCS_ENABLED=true

# ── Request limits ───────────────────────────────────────────────────────────
MAX_BODY_SIZE_BYTES=1000000

# ── Rate limiting (in-memory, single backend process only — see README) ──────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_SIGNUP_MAX=3
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=60
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_ADD_SYMBOL_MAX=10
RATE_LIMIT_ADD_SYMBOL_WINDOW_SECONDS=60
RATE_LIMIT_DEMO_MAX=1
RATE_LIMIT_DEMO_WINDOW_SECONDS=20
