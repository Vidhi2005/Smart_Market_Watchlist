# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://smartwatchlist:smartwatchlist@localhost:5432/smart_market_watchlist

# ── Market Data ───────────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_finnhub_api_key_here
